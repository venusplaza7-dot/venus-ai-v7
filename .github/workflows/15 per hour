name: v8-15-per-hour

on:
  schedule:
    - cron: "*/4 * * * *" # every 4 min = 15 per hour
  workflow_dispatch: # manual run button

jobs:
  send:
    runs-on: ubuntu-latest
    steps:
      - name: Trigger autonomous lead email
        run: |
          curl -X GET "https://venus-ai-v8.vercel.app/api/real" -H "Cache-Control: no-cache" -v
          echo "Sent 1 autonomous email - next in 4 min"

